import Electrical
import ElectricPower

from "parts/Texas_Instruments_CD74HC4067SM96/Texas_Instruments_CD74HC4067SM96.ato" import Texas_Instruments_CD74HC4067SM96_package
from "parts/PJSEMI_AH49HSC/PJSEMI_AH49HSC.ato" import PJSEMI_AH49HSC_package

module MuxColumn:
    """
    A CD74HC4067 16-to-1 analog multiplexer with 11 AH49HSC Hall-effect sensors attached to it.
    """

    power_3v3 = new ElectricPower
    S0 = new Electrical
    S1 = new Electrical
    S2 = new Electrical
    S3 = new Electrical
    OUT = new Electrical

    mux = new Texas_Instruments_CD74HC4067SM96_package
    mux.VCC ~ power_3v3.hv
    mux.GND ~ power_3v3.lv
    mux.nE ~ power_3v3.lv  # active-low enable, tied low = always enabled
    mux.S0 ~ S0
    mux.S1 ~ S1
    mux.S2 ~ S2
    mux.S3 ~ S3

    sensors = new PJSEMI_AH49HSC_package[11]
    for sensor in sensors:
        sensor.VDD ~ power_3v3.hv
        sensor.GND ~ power_3v3.lv

    sensors[0].OUT ~ mux.I10
    sensors[1].OUT ~ mux.I9
    sensors[2].OUT ~ mux.I8
    sensors[3].OUT ~ mux.I0
    sensors[4].OUT ~ mux.I1
    sensors[5].OUT ~ mux.I2
    sensors[6].OUT ~ mux.I3
    sensors[7].OUT ~ mux.I4
    sensors[8].OUT ~ mux.I5
    sensors[9].OUT ~ mux.I6
    sensors[10].OUT ~ mux.I7

    mux.I11 ~ power_3v3.lv
    mux.I12 ~ power_3v3.lv
    mux.I13 ~ power_3v3.lv
    mux.I14 ~ power_3v3.lv
    mux.I15 ~ power_3v3.lv

    mux.COMMONINOUT_OUTPUT ~ OUT

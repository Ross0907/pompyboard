{
    // General
    "editor.formatOnSave": true,
    "editor.rulers": [100],
    "deno.enablePaths": ["./scripts"],
    "cSpell.import": ["${workspaceFolder}/cspell.yaml"],
    "files.readonlyInclude": {
        "web/convex/_generated/*": true
    },
    "files.associations": {
        "*.svd": "xml",
        "*.css": "tailwindcss",
        "LICENSE-*": "plaintext"
    },

    // Rust
    "rust-analyzer.check.allTargets": false,
    "rust-analyzer.check.targets": "thumbv7em-none-eabihf",
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer"
    },

    // Etc
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "[javascript][javascriptreact][typescript][typescriptreact][css][postcss][json][jsonc][markdown][yaml][github-actions-workflow]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml"
    },
    "[ato]": {
        "editor.defaultFormatter": "atopile.atopile"
    }
}
